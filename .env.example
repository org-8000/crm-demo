# === 数据库 ===
POSTGRES_USER=mip
POSTGRES_PASSWORD=mip
POSTGRES_DB=mip
DATABASE_URL=postgresql+psycopg://mip:mip@localhost:5432/mip

# === AgentOS ===
# 若设置则 AgentOS 要求 Authorization: Bearer <key>
OS_SECURITY_KEY=
# 生产建议 false（业务表用 migrations/*.sql 管理）
AUTO_PROVISION_DBS=true

# === LLM（模型无关，二选一或自配）===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === 采集/富化 ===
FIRECRAWL_API_KEY=
PROXYCURL_API_KEY=

# === 前端 BFF ===
AGENTOS_BASE_URL=http://localhost:8000

# === 合规 feature flags（高风险能力，默认关闭）===
ENABLE_M2_GROUP_MONITOR=false   # ②群聊/私域招标监控 🔴
ENABLE_M6_AUTOSEND=false        # ⑥LinkedIn 自动发送 🔴
ENABLE_SOCIAL_DEEP_SCRAPE=false # ①②深度社媒抓取 🟡
